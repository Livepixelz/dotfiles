#!/usr/bin/env python3
"""macctld — daemon HTTP minimal qui expose `macctl` à l'iPhone (via Tailscale).

Chaque route se contente d'appeler le CLI `macctl` : une seule source de vérité.
Sécurité : bind sur l'IP Tailscale (jamais le LAN/Internet) + token Bearer.

  GET  /health            -> {"ok": true}                (sans auth, pour tester la joignabilité)
  GET  /status            -> état JSON du Mac
  POST /sleep             -> veille
  POST /displaysleep      -> écran éteint
  POST /lock              -> verrouillage session
  POST /restart           -> redémarrage
  POST /shutdown          -> extinction
  POST /caffeinate        -> anti-veille (?secs=3600 optionnel)
  POST /decaffeinate      -> ré-autorise la veille
  POST /wake              -> magic packet Wake-on-LAN (?mac=..&bcast=.. optionnels)

Toutes les routes sauf /health exigent l'en-tête : Authorization: Bearer <token>
"""
import hmac
import json
import os
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

MACCTL = os.environ.get("MACCTL_BIN", "macctl")


def macctl(*args):
    """Exécute `macctl <args>` et renvoie (rc, stdout)."""
    try:
        p = subprocess.run([MACCTL, *args], capture_output=True, text=True, timeout=30)
        return p.returncode, (p.stdout or p.stderr).strip()
    except Exception as exc:  # pragma: no cover
        return 1, str(exc)


def load_config():
    rc, out = macctl("config")
    if rc != 0:
        sys.exit(f"macctld: impossible de lire la config: {out}")
    return json.loads(out)


CFG = load_config()
try:
    with open(os.path.expanduser(CFG["token_file"]), "r", encoding="utf-8") as fh:
        TOKEN = fh.read().strip()
except OSError:
    # Génère le token via macctl puis relit
    macctl("token")
    with open(os.path.expanduser(CFG["token_file"]), "r", encoding="utf-8") as fh:
        TOKEN = fh.read().strip()

# route -> (méthode HTTP, fonction produisant (rc, texte))
ROUTES = {
    "/status":       ("GET",  lambda q: macctl("status")),
    "/sleep":        ("POST", lambda q: macctl("sleep")),
    "/displaysleep": ("POST", lambda q: macctl("displaysleep")),
    "/lock":         ("POST", lambda q: macctl("lock")),
    "/restart":      ("POST", lambda q: macctl("restart")),
    "/shutdown":     ("POST", lambda q: macctl("shutdown")),
    "/decaffeinate": ("POST", lambda q: macctl("decaffeinate")),
    "/caffeinate":   ("POST", lambda q: macctl("caffeinate", (q.get("secs", ["0"])[0]))),
    "/wake":         ("POST", lambda q: macctl(
        "wake", *[v for v in (q.get("mac", [None])[0], q.get("bcast", [None])[0]) if v])),
}


class Handler(BaseHTTPRequestHandler):
    server_version = "macctld/1.0"

    def _send(self, code, payload):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self):
        header = self.headers.get("Authorization", "")
        prefix = "Bearer "
        if not header.startswith(prefix):
            return False
        return hmac.compare_digest(header[len(prefix):].strip(), TOKEN)

    def _dispatch(self, method):
        path = urlparse(self.path).path.rstrip("/") or "/"
        query = parse_qs(urlparse(self.path).query)

        if path == "/health":
            return self._send(200, {"ok": True})

        route = ROUTES.get(path)
        if route is None:
            return self._send(404, {"error": "not found"})
        if route[0] != method:
            return self._send(405, {"error": "method not allowed"})
        if not self._authorized():
            return self._send(401, {"error": "unauthorized"})

        rc, out = route[1](query)
        # /status renvoie déjà du JSON : on le passe tel quel
        if path == "/status" and rc == 0:
            try:
                return self._send(200, json.loads(out))
            except json.JSONDecodeError:
                pass
        return self._send(200 if rc == 0 else 500, {"ok": rc == 0, "result": out})

    def do_GET(self):
        self._dispatch("GET")

    def do_POST(self):
        self._dispatch("POST")

    def log_message(self, fmt, *args):
        sys.stderr.write("macctld %s - %s\n" % (self.address_string(), fmt % args))


def main():
    host, port = CFG["bind"], int(CFG["port"])
    httpd = ThreadingHTTPServer((host, port), Handler)
    print(f"macctld: écoute sur http://{host}:{port} (mode bind: {CFG['bind_mode']})",
          file=sys.stderr)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        httpd.shutdown()


if __name__ == "__main__":
    main()
