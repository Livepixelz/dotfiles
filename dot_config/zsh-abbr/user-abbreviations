# zsh-abbr — global dev abbreviations
# Expand with space. Edit with `abbr add` / `abbr erase`.

# --- git ---
abbr -S g="git"
abbr -S gds="git diff --staged"
abbr -S gap="git add -p"
abbr -S gca="git commit --amend --no-edit"
abbr -S gsw="git switch"
abbr -S gpf="git push --force-with-lease"
abbr -S gpl="git pull --rebase"
abbr -S gb="git branch"
abbr -S gstp="git stash pop"
abbr -S grhh="git reset --hard HEAD"
abbr -S lg="lazygit"

# --- gh ---
abbr -S ghpr="gh pr create --fill"
abbr -S ghprv="gh pr view --web"
abbr -S ghprc="gh pr checks"
abbr -S ghprl="gh pr list"
abbr -S ghd="gh dash"

# --- bun / node ---
abbr -S p="bun"
abbr -S pi="bun install"
abbr -S pa="bun add"
abbr -S pad="bun add -d"
abbr -S pr="bun run"
abbr -S pd="bun run dev"
abbr -S pb="bun run build"
abbr -S pt="bun test"
abbr -S px="bunx"
abbr -S nx="bunx"

# --- nuxt ---
abbr -S nd="bunx nuxt dev"
abbr -S nb="bunx nuxt build"
abbr -S npr="bunx nuxt prepare"

# --- python / uv ---
abbr -S py="python3"
abbr -S uvr="uv run"
abbr -S uva="uv add"

# --- docker / infra ---
abbr -S d="docker"
abbr -S dc="docker compose"
abbr -S dcu="docker compose up -d"
abbr -S dcd="docker compose down"
abbr -S dcl="docker compose logs -f"
abbr -S lzd="lazydocker"
abbr -S k="kubectl"

# --- doppler ---
abbr -S dop="doppler"
abbr -S dopr="doppler run --"
abbr -S dops="doppler secrets"

# --- 1password ---
abbr -S opr="op run --"

# --- nav / files ---
abbr -S z.="zed ."
abbr -S ..="cd .."
abbr -S ...="cd ../.."

# --- pueue (background jobs) ---
abbr -S bg="pueue add --"
abbr -S bgs="pueue status"
abbr -S bgl="pueue log"
abbr -S bgf="pueue follow"
abbr -S bgc="pueue clean"

# --- misc ---
abbr -S h="history"
abbr -S cls="clear"
abbr -S rgi="rg -i"
abbr -S fdh="fd --hidden"
