// ─── Layout dédié Clutchdata (HoopMetrics) ─────────────────────────────────
// Monorepo Nuxt 4 (frontend) + FastAPI (backend), docker compose via doppler.
// Lancement automatique via `hxc` depuis ~/code/clutchdata
// ───────────────────────────────────────────────────────────────────────────

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // ── 1. Code : Helix + Claude Code ──────────────────────────────────────
    tab name="code" focus=true {
        pane split_direction="vertical" {
            pane name="editor" size="65%" focus=true {
                command "hx"
                args "."
                start_suspended false
            }
            pane name="claude" size="35%" {
                command "claude"
                start_suspended false
            }
        }
    }

    // ── 2. Stack : full docker compose + logs ──────────────────────────────
    tab name="stack" {
        pane split_direction="vertical" {
            pane name="compose" size="60%" {
                command "bun"
                args "run" "dev"
                start_suspended true
            }
            pane name="logs" size="40%" {
                command "bun"
                args "run" "dev:logs"
                start_suspended true
            }
        }
    }

    // ── 3. Dev : frontend (Nuxt) + backend (FastAPI) en parallèle ─────────
    tab name="dev" {
        pane split_direction="horizontal" {
            pane name="frontend" size="50%" {
                command "bun"
                args "run" "dev:frontend"
                start_suspended true
            }
            pane name="backend" size="50%" {
                command "bun"
                args "run" "dev:backend"
                start_suspended true
            }
        }
    }

    // ── 4. Tests : typecheck + unit (front | back) ─────────────────────────
    tab name="tests" {
        pane split_direction="vertical" {
            pane name="frontend-test" size="50%" {
                command "bun"
                args "run" "test:frontend"
                start_suspended true
            }
            pane name="backend-test" size="50%" {
                command "bun"
                args "run" "test:backend"
                start_suspended true
            }
        }
    }

    // ── 5. Git : lazygit + gh dash ─────────────────────────────────────────
    tab name="git" {
        pane split_direction="vertical" {
            pane name="lazygit" size="50%" {
                command "lazygit"
                start_suspended false
            }
            pane name="gh-dash" size="50%" {
                command "gh"
                args "dash"
                start_suspended false
            }
        }
    }

    // ── 6. DB : pgcli (via doppler) + doppler shell ────────────────────────
    tab name="db" {
        pane split_direction="vertical" {
            pane name="pgcli" size="50%" {
                command "doppler"
                args "run" "--project" "clutchdata" "--config" "develop" "--" "pgcli"
                start_suspended true
            }
            pane name="doppler" size="50%" {
                command "doppler"
                args "run" "--project" "clutchdata" "--config" "develop" "--" "zsh"
                start_suspended true
            }
        }
    }
}
