layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="code" focus=true {
        pane split_direction="vertical" {
            pane name="editor" size="65%" focus=true {
                command "hx"
                args "."
            }
            pane name="claude" size="35%" {
                command "claude"
            }
        }
    }

    tab name="run" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" size="35%" {
                pane name="frontend" {
                    command "bun"
                    args "run" "dev:frontend"
                }
                pane name="lint" {
                    command "bunx"
                    args "biome" "check" "--watch" "."
                }
            }
            pane split_direction="horizontal" size="35%" {
                pane name="backend" {
                    command "bun"
                    args "run" "dev:backend"
                }
                pane name="logs"
            }
            pane split_direction="horizontal" size="30%" {
                pane name="typecheck" {
                    command "bunx"
                    args "tsc" "--watch" "--noEmit"
                }
                pane name="test" {
                    command "bun"
                    args "test" "--watch"
                }
                pane name="shell"
            }
        }
    }

    tab name="test" {
        pane split_direction="vertical" {
            pane name="posting" size="55%" focus=true {
                command "posting"
            }
            pane name="shell" size="45%"
        }
    }

    tab name="git" {
        pane split_direction="vertical" {
            pane name="lazygit" size="60%" focus=true {
                command "lazygit"
            }
            pane name="gh-dash" size="40%" {
                command "gh"
                args "dash"
            }
        }
    }
}
