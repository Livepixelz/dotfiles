// Layout zellij — projet Vue / Vite
// Lancer depuis la racine du projet : zellij --layout vue
layout {
    tab name="dev" focus=true {
        pane split_direction="vertical" {
            pane name="editor" size="60%"
            pane split_direction="horizontal" {
                pane name="vite" {
                    command "pnpm"
                    args "dev"
                }
                pane name="shell"
            }
        }
    }
    tab name="test" {
        // Démarré suspendu : appuie sur Entrée pour lancer le watch
        pane name="vitest" {
            command "pnpm"
            args "test:unit"
            start_suspended true
        }
    }
    tab name="git" {
        pane name="lazygit" {
            command "lazygit"
        }
    }
}
