# Helix + Claude Code — layout per-project avec fallback
# Lookup order :
#   1. ./.zellij/layout.kdl (committable dans le repo)
#   2. ~/.config/zellij/layouts/<dirname>.kdl
#   3. helix-claude (default)
hxc() {
  local project="$(basename "$(pwd)")"
  local session_name="hxc-${project}"
  local layout="helix-claude"

  if [[ -f "./.zellij/layout.kdl" ]]; then
    layout="$(pwd)/.zellij/layout.kdl"
  elif [[ -f "$HOME/.config/zellij/layouts/${project}.kdl" ]]; then
    layout="$project"
  fi

  zellij attach -c "$session_name" options --default-layout "$layout"
}

