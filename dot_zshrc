export LSCOLORS=GxFxCxDxBxegedabagaced

# ── Prompt ────────────────────────────────────────────────────────────────────
if ! command -v starship >/dev/null 2>&1; then
  emojis=("👾" "🌐" "🎲" "🌍" "🐉" "🌵")
  EMOJI=${emojis[$RANDOM % ${#emojis[@]}]}

  txtred='\e[0;31m'
  bldpur='\e[1;35m'
  txtgrn='\e[0;32m'
  txtrst='\e[0m'

  print_before_the_prompt() {
    local dir vcs_prompt
    dir=${PWD/"$HOME"/"~"}
    if command -v vcprompt >/dev/null 2>&1; then
      vcs_prompt="$(vcprompt)"
    fi
    printf "\n $txtred%s: $bldpur%s $txtgrn%s\n$txtrst" "$HOST_NAME" "$dir" "$vcs_prompt"
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd print_before_the_prompt
  PROMPT="$EMOJI > "
fi

# ── Fun ───────────────────────────────────────────────────────────────────────
if command -v fortune >/dev/null 2>&1; then
  tip=$(fortune webdev)
  width=60
  line=$(printf '─%.0s' {1..$width})
  echo ""
  echo "  \033[1;33m🏀 Tip-off du jour\033[0m"
  echo "  \033[0;90m┌${line}┐\033[0m"
  echo "$tip" | fold -s -w $width | while IFS= read -r l; do
    printf "  \033[0;90m│\033[0m %-${width}s \033[0;90m│\033[0m\n" "$l"
  done
  echo "  \033[0;90m└${line}┘\033[0m"
  echo ""
fi

# ── Fonctions ─────────────────────────────────────────────────────────────────
function mkcd() { mkdir -p "$1" && cd "$1"; }

# BallDontLie API (NBA)
bdl() {
  local key base="https://api.balldontlie.io/v1"
  key=$(grep BALLDONTLIE_API_KEY ~/.env 2>/dev/null | cut -d= -f2)
  if [[ -z "$1" || "$1" == "help" ]]; then
    echo "Usage: bdl <resource> [params]"
    echo "  players  teams  games  stats  season_averages  injuries  standings  box_scores"
    echo "Ex: bdl players search=luka | bdl games seasons[]=2024 team_ids[]=5"
    return 0
  fi
  local resource="$1"; shift
  http --ignore-stdin GET "$base/$resource" Authorization:"$key" "$@"
}

