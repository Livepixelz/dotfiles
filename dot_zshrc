# ── Dotfiles ambient check ────────────────────────────────────────────────────
# Quiet daily check. Notifications via macOS native — no shell clutter.
_dotfiles_check() {
  local repo="$HOME/.local/share/chezmoi"
  local stamp="$HOME/.cache/dotfiles-check.stamp"
  command -v chezmoi >/dev/null 2>&1 || return
  [ -d "$repo/.git" ] || return
  mkdir -p "$(dirname "$stamp")"
  local now=$(date +%s)
  local last=0
  [ -f "$stamp" ] && last=$(cat "$stamp" 2>/dev/null || echo 0)
  (( now - last < 86400 )) && return
  echo "$now" > "$stamp"
  (
    git -C "$repo" fetch --quiet origin 2>/dev/null
    local behind=$(git -C "$repo" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
    local dirty=$(chezmoi status 2>/dev/null | grep -v '^R' | wc -l | tr -d ' ')
    if (( behind > 0 )); then
      print -P "  ${(%):-%F{117}}∙${(%):-%f} dotfiles · $behind behind origin · ${(%):-%F{215}}dots pull${(%):-%f}"
      command -v terminal-notifier >/dev/null 2>&1 && terminal-notifier -title "dotfiles" -message "$behind commit(s) behind origin" -group dots >/dev/null 2>&1
    fi
    if (( dirty > 0 )); then
      print -P "  ${(%):-%F{141}}∙${(%):-%f} dotfiles · $dirty modified locally · ${(%):-%F{215}}dots push${(%):-%f}"
    fi
  ) &!
}
add-zsh-hook precmd _dotfiles_check

# ── First-run welcome (one-shot per machine) ──────────────────────────────────
