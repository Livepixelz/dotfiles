HOST_NAME=lvpxlz

export PATH=$PATH:$HOME/bin:$HOME/.local/bin

# ── Histoire ──────────────────────────────────────────────────────────────────
export HISTSIZE=50000
export SAVEHIST=10000
export HISTFILE="$HOME/.zsh_history"

# ── Couleurs ──────────────────────────────────────────────────────────────────
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

txtred='\e[0;31m'
txtgrn='\e[0;32m'
bldgrn='\e[1;32m'
bldpur='\e[1;35m'
txtrst='\e[0m'

# ── Prompt (fallback si starship absent) ─────────────────────────────────────
emojis=("👾" "🌐" "🎲" "🌍" "🐉" "🌵")
EMOJI=${emojis[$RANDOM % ${#emojis[@]}]}

print_before_the_prompt() {
  local dir vcs_prompt
  dir=${PWD/"$HOME"/"~"}
  if command -v vcprompt >/dev/null 2>&1; then
    vcs_prompt="$(vcprompt)"
  fi
  printf "\n $txtred%s: $bldpur%s $txtgrn%s\n$txtrst" "$HOST_NAME" "$dir" "$vcs_prompt"
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd print_before_the_prompt

if ! command -v starship >/dev/null 2>&1; then
  PROMPT="$EMOJI > "
fi

# ── Fun ───────────────────────────────────────────────────────────────────────
if command -v fortune >/dev/null 2>&1 && command -v cowsay >/dev/null 2>&1; then
  fortune | cowsay -f tux
fi

# ── Fonctions ─────────────────────────────────────────────────────────────────
function mkcd() { mkdir "$1" && cd "$1"; }

# BallDontLie API (NBA)
bdl() {
  local key base="https://api.balldontlie.io/v1"
  key=$(grep BALLDONTLIE_API_KEY ~/.env 2>/dev/null | cut -d= -f2)
  if [[ -z "$1" || "$1" == "help" ]]; then
    echo "Usage: bdl <resource> [params]"
    echo "  players  teams  games  stats  season_averages  injuries  standings  box_scores"
    echo "Ex: bdl players search=luka | bdl games seasons[]=2024 team_ids[]=5"
    return 0
  fi
  local resource="$1"; shift
  http --ignore-stdin GET "$base/$resource" Authorization:"$key" "$@"
}

# ── Homebrew (macOS) ──────────────────────────────────────────────────────────
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  export PATH="/opt/homebrew/opt/openssl@1.1/bin:$PATH"
fi

# ── NVM (lazy load) ───────────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
load_nvm() {
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
  unset -f load_nvm node npm npx pnpm yarn corepack
}
node()     { load_nvm; node "$@"; }
npm()      { load_nvm; npm "$@"; }
npx()      { load_nvm; npx "$@"; }
pnpm()     { load_nvm; pnpm "$@"; }
yarn()     { load_nvm; yarn "$@"; }
corepack() { load_nvm; corepack "$@"; }

# ── fnm ───────────────────────────────────────────────────────────────────────
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# ── pyenv ─────────────────────────────────────────────────────────────────────
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
fi

# ── bun ───────────────────────────────────────────────────────────────────────
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# ── fzf ───────────────────────────────────────────────────────────────────────
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# ── zoxide (remplace cd) ──────────────────────────────────────────────────────
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias cd="z"
fi

