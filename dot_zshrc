# ── Secrets & overrides locaux ────────────────────────────────────────────────
# Fichier non versionné : OPENAI_API_KEY, MISTRAL_API_KEY, POSTGRES_URL, VPS alias…
[ -f "$HOME/.zsh_secrets" ] && source "$HOME/.zsh_secrets"

# ── Plugins zsh ───────────────────────────────────────────────────────────────
[ -f "$HOME/.zsh/fast-syntax-highlighting/F-Sy-H.plugin.zsh" ] && source "$HOME/.zsh/fast-syntax-highlighting/F-Sy-H.plugin.zsh"
[ -f "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && source "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -f "$HOME/.zsh/history.zsh" ]     && source "$HOME/.zsh/history.zsh"
[ -f "$HOME/.zsh/key-bindings.zsh" ] && source "$HOME/.zsh/key-bindings.zsh"
[ -f "$HOME/.zsh/completion.zsh" ]  && source "$HOME/.zsh/completion.zsh"

# ── Complétion ────────────────────────────────────────────────────────────────
autoload -Uz compinit
typeset -i updated_at
updated_at=$(date +'%j' -r ~/.zcompdump 2>/dev/null || stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null || echo 0)
if [ "$(date +'%j')" != "$updated_at" ]; then
  compinit -i
else
  compinit -C -i
fi
zmodload -i zsh/complist

# ── Starship ──────────────────────────────────────────────────────────────────
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# ── pipx / envman ─────────────────────────────────────────────────────────────
export PATH="$PATH:$HOME/.local/bin"
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"
