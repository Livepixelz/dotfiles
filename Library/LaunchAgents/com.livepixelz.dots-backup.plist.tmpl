{{- if eq .chezmoi.os "darwin" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.livepixelz.dots-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>-i</string>
    <string>-c</string>
    <string>dots backup</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/.cache/dots-backup.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/.cache/dots-backup.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
{{- end -}}
