{{- if and (eq .chezmoi.os "darwin") .features.scheduled_jobs -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.livepixelz.brewfile-dump</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>-c</string>
    <string>/opt/homebrew/bin/brew bundle dump --file={{ .chezmoi.sourceDir }}/Brewfile --force --quiet</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/.cache/dots-brewfile-dump.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/.cache/dots-brewfile-dump.log</string>
</dict>
</plist>
{{- end -}}
