{{- if and (eq .chezmoi.os "darwin") (dig "features" "remote_control" false .) -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.livepixelz.macctld</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>-c</string>
    <string>exec "{{ .chezmoi.homeDir }}/.local/bin/macctld"</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/.cache/macctld.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/.cache/macctld.log</string>
</dict>
</plist>
{{- end -}}
