# Feature-gated zsh extras — generated by chezmoi from features.* flags
# Toggle in ~/.config/chezmoi/chezmoi.toml then run `chezmoi apply`.

{{ if .features.fzf_tab -}}
# ── fzf-tab ───────────────────────────────────────────────────────────────────
[ -f "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh" ] && source "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh"
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath 2>/dev/null || ls -1 $realpath'
{{ end }}

{{ if .features.zsh_abbr -}}
# ── zsh-abbr (smart abbreviations) ────────────────────────────────────────────
[ -f "$HOME/.zsh/zsh-abbr/zsh-abbr.zsh" ] && source "$HOME/.zsh/zsh-abbr/zsh-abbr.zsh"
{{ end }}

{{ if .features.onepassword -}}
# ── 1Password CLI helpers ─────────────────────────────────────────────────────
if command -v op >/dev/null 2>&1; then
  op_secret() { op read "$1" 2>/dev/null; }
  # Example uses (uncomment & adapt in ~/.zsh_secrets):
  # export GITHUB_TOKEN="$(op_secret op://Personal/github/token)"
  # export ANTHROPIC_API_KEY="$(op_secret op://Personal/anthropic/api_key)"
fi
{{ end }}

# ── dots-* maintenance commands ───────────────────────────────────────────────
dots-doctor() {
  local repo="$HOME/.local/share/chezmoi"
  echo "🩺 dotfiles health check"
  echo
  print -P "%F{cyan}── binaries%f"
  for b in chezmoi brew git zsh starship atuin fzf zoxide eza bat fd rg btop lazygit zellij delta mise; do
    if command -v "$b" >/dev/null 2>&1; then
      print -P "  %F{green}✓%f $b"
    else
      print -P "  %F{red}✗%f $b (missing)"
    fi
  done
  echo
  print -P "%F{cyan}── zsh plugins%f"
  for p in fast-syntax-highlighting zsh-autosuggestions fzf-tab zsh-abbr; do
    if [ -d "$HOME/.zsh/$p" ]; then
      print -P "  %F{green}✓%f $p"
    else
      print -P "  %F{yellow}–%f $p (not installed)"
    fi
  done
  echo
  print -P "%F{cyan}── chezmoi state%f"
  local dirty=$(chezmoi status 2>/dev/null | wc -l | tr -d ' ')
  (( dirty > 0 )) && print -P "  %F{magenta}⚠%f $dirty local change(s) not in source" || print -P "  %F{green}✓%f source ↔ home in sync"
  git -C "$repo" fetch --quiet 2>/dev/null
  local behind=$(git -C "$repo" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
  (( behind > 0 )) && print -P "  %F{cyan}⚠%f $behind commit(s) behind origin" || print -P "  %F{green}✓%f up-to-date with origin"
}

dots-update() {
  echo "→ chezmoi update..."
  chezmoi update -v
  if command -v brew >/dev/null 2>&1; then
    echo "→ brew upgrade..."
    brew upgrade --quiet 2>&1 | tail -5
  fi
  if command -v mise >/dev/null 2>&1; then
    echo "→ mise upgrade..."
    mise upgrade --quiet 2>&1 | tail -5
  fi
  rm -f "$HOME/.cache/dotfiles-check.stamp"
  echo "✓ done"
}

dots-stats() {
  local repo="$HOME/.local/share/chezmoi"
  local managed=$(chezmoi managed 2>/dev/null | wc -l | tr -d ' ')
  local commits=$(git -C "$repo" rev-list --count HEAD 2>/dev/null)
  local last=$(git -C "$repo" log -1 --format='%cr' 2>/dev/null)
  local size=$(du -sh "$repo" 2>/dev/null | awk '{print $1}')
  print -P "%F{cyan}dotfiles%f · $managed managed files · $commits commits · last update $last · $size"
}

dots-backup() {
  local dest="${1:-$HOME/Backups}"
  local stamp=$(date +%Y%m%d-%H%M%S)
  mkdir -p "$dest"
  local out="$dest/dotfiles-snapshot-$stamp.tar.zst"
  echo "→ snapshotting ~/.config + tracked dotfiles to $out..."
  tar --use-compress-program=zstd -cf "$out" \
    -C "$HOME" \
    .config .zshrc .gitconfig .gitignore_global .zsh 2>/dev/null
  echo "✓ $(du -sh "$out" | awk '{print $1}') saved"
}
