# Feature-gated zsh extras — generated by chezmoi from features.* flags
# Toggle via `chezmoi edit-config`, then `chezmoi apply`.

[ -f "$HOME/.zsh/dots-ui.zsh" ] && source "$HOME/.zsh/dots-ui.zsh"

{{ if .features.fzf_tab -}}
# ── fzf-tab ───────────────────────────────────────────────────────────────────
[ -f "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh" ] && source "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh"
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath 2>/dev/null || ls -1 $realpath'
{{ end }}

{{ if .features.zsh_abbr -}}
# ── zsh-abbr (smart abbreviations) ────────────────────────────────────────────
[ -f "$HOME/.zsh/zsh-abbr/zsh-abbr.zsh" ] && source "$HOME/.zsh/zsh-abbr/zsh-abbr.zsh"
{{ end }}

{{ if .features.onepassword -}}
# ── 1Password CLI helpers ─────────────────────────────────────────────────────
if command -v op >/dev/null 2>&1; then
  op_secret() { op read "$1" 2>/dev/null; }
fi
{{ end }}

# ─────────────────────────────────────────────────────────────────────────────
#                          dots — master command
# ─────────────────────────────────────────────────────────────────────────────
dots() {
  local cmd="${1:-help}"; shift 2>/dev/null || true
  case "$cmd" in
    status)  _dots_status  "$@" ;;
    doctor)  _dots_doctor  "$@" ;;
    update)  _dots_update  "$@" ;;
    pull)    _dots_pull    "$@" ;;
    push)    _dots_push    "$@" ;;
    stats)   _dots_stats   "$@" ;;
    backup)  _dots_backup  "$@" ;;
    welcome) _dots_welcome "$@" ;;
    edit)    _dots_edit    "$@" ;;
    config)  chezmoi edit-config ;;
    apply)   chezmoi apply -v ;;
    cd)      chezmoi cd ;;
    diff)    _dots_diff    "$@" ;;
    search)  _dots_search  "$@" ;;
    focus)   _dots_focus   "$@" ;;
    docs)    _dots_docs    "$@" ;;
    audit)   _dots_audit   "$@" ;;
    bench)   _dots_bench   "$@" ;;
    help|--help|-h) _dots_help ;;
    *)
      dui_err "unknown command: $cmd"
      _dots_help
      return 1
      ;;
  esac
}

_dots_help() {
  dui_header "dots" "Personal dotfiles command center"
  print -P "  ${DUI[dim]}usage:${DUI[r]} ${DUI[b]}dots${DUI[B]} ${DUI[purple]}<command>${DUI[r]} [args]"
  dui_section "Sync"
  print -P "    ${DUI[purple]}status${DUI[r]}    show local drift + remote diff"
  print -P "    ${DUI[purple]}pull${DUI[r]}      git pull + chezmoi apply"
  print -P "    ${DUI[purple]}push${DUI[r]}      re-add changes + commit + push"
  print -P "    ${DUI[purple]}apply${DUI[r]}     chezmoi apply (verbose)"
  dui_section "Health"
  print -P "    ${DUI[purple]}doctor${DUI[r]}    verify binaries, plugins, sync state"
  print -P "    ${DUI[purple]}stats${DUI[r]}     repo numbers at a glance"
  dui_section "Maintenance"
  print -P "    ${DUI[purple]}update${DUI[r]}    chezmoi + brew + mise (all in one)"
  print -P "    ${DUI[purple]}backup${DUI[r]}    snapshot ~/.config to ~/Backups (keeps last 10)"
  print -P "    ${DUI[purple]}edit${DUI[r]}      fzf-pick a managed file, then chezmoi edit"
  print -P "    ${DUI[purple]}config${DUI[r]}    open ~/.config/chezmoi/chezmoi.toml"
  print -P "    ${DUI[purple]}cd${DUI[r]}        enter the chezmoi source repo"
  dui_section "Explore"
  print -P "    ${DUI[purple]}diff${DUI[r]}      colored diff between source and home"
  print -P "    ${DUI[purple]}search${DUI[r]}    fuzzy search across managed files"
  print -P "    ${DUI[purple]}docs${DUI[r]}      render README in glow"
  dui_section "Productivity"
  print -P "    ${DUI[purple]}focus${DUI[r]}     toggle DnD + quit distracting apps"
  print -P "    ${DUI[purple]}audit${DUI[r]}     check permissions on sensitive files"
  print -P "    ${DUI[purple]}bench${DUI[r]}     profile zsh startup time"
  dui_section "Discover"
  print -P "    ${DUI[purple]}welcome${DUI[r]}   first-run tour & feature summary"
  dui_footer "tip: alias d='dots' for max ergonomics"
}

# ── status ────────────────────────────────────────────────────────────────────
_dots_status() {
  local repo="$HOME/.local/share/chezmoi"
  dui_header "dots status"
  dui_section "Local"
  local dirty=$(chezmoi status 2>/dev/null | grep -v '^R' | wc -l | tr -d ' ')
  if (( dirty > 0 )); then
    dui_warn "$dirty file(s) modified locally — run ${DUI[b]}dots push${DUI[B]}"
    chezmoi status | sed 's/^/        /'
  else
    dui_ok "source ↔ home in sync"
  fi
  dui_section "Remote"
  git -C "$repo" fetch --quiet 2>/dev/null
  local behind=$(git -C "$repo" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
  local ahead=$(git -C "$repo" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
  (( behind > 0 )) && dui_warn "$behind commit(s) behind origin — run ${DUI[b]}dots pull${DUI[B]}" || dui_ok "up-to-date with origin/master"
  (( ahead > 0 ))  && dui_info "$ahead local commit(s) not pushed"
  dui_footer
}

# ── doctor ────────────────────────────────────────────────────────────────────
_dots_doctor() {
  dui_header "dots doctor" "health check"
  dui_section "Binaries"
  local missing=0
  for b in chezmoi brew git zsh starship atuin fzf zoxide eza bat fd rg btop lazygit zellij delta mise gh; do
    if command -v "$b" >/dev/null 2>&1; then
      dui_ok "$b"
    else
      dui_err "$b ${DUI[dim]}(missing — try ${DUI[fg]}brew install $b${DUI[dim]})${DUI[r]}"
      ((missing++))
    fi
  done
  dui_section "Zsh plugins"
  for p in fast-syntax-highlighting zsh-autosuggestions fzf-tab zsh-abbr; do
    if [ -d "$HOME/.zsh/$p" ]; then
      dui_ok "$p"
    else
      dui_warn "$p ${DUI[dim]}(toggle features.zsh_plugins_auto)${DUI[r]}"
    fi
  done
  dui_section "Sync state"
  local repo="$HOME/.local/share/chezmoi"
  local dirty=$(chezmoi status 2>/dev/null | grep -v '^R' | wc -l | tr -d ' ')
  (( dirty > 0 )) && dui_warn "$dirty local change(s)" || dui_ok "source ↔ home in sync"
  git -C "$repo" fetch --quiet 2>/dev/null
  local behind=$(git -C "$repo" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
  (( behind > 0 )) && dui_warn "$behind commit(s) behind origin" || dui_ok "up-to-date with origin"
  if (( missing > 0 )); then
    dui_footer "$missing missing binar(y/ies) — see above"
  else
    dui_footer "all clear — your config is healthy"
  fi
}

# ── update / pull / push (quiet by default, `-v` for full logs) ───────────────
_dots_update() {
  local verbose=0
  [[ "${1:-}" == "-v" || "${1:-}" == "--verbose" ]] && verbose=1
  dui_header "dots update" "chezmoi + brew + mise"

  if (( verbose )); then
    dui_step "chezmoi sync"; chezmoi update -v 2>&1 | sed 's/^/      /'
    if command -v brew >/dev/null 2>&1; then dui_step "brew upgrade"; brew upgrade 2>&1 | sed 's/^/      /'; fi
    if command -v mise >/dev/null 2>&1; then dui_step "mise upgrade"; mise upgrade 2>&1 | sed 's/^/      /'; fi
  else
    dui_spin "syncing chezmoi" chezmoi update
    if command -v brew >/dev/null 2>&1; then
      local pending=$(brew outdated --quiet 2>/dev/null | wc -l | tr -d ' ')
      if (( pending > 0 )); then
        dui_spin "upgrading $pending brew package(s)" brew upgrade --quiet
      else
        dui_ok "brew up-to-date"
      fi
    fi
    if command -v mise >/dev/null 2>&1; then
      dui_spin "syncing mise runtimes" mise upgrade --quiet
    fi
  fi

  rm -f "$HOME/.cache/dotfiles-check.stamp"
  dui_notify "dotfiles" "system updated"
  dui_footer "system is fresh"
}

_dots_pull() {
  local verbose=0
  [[ "${1:-}" == "-v" || "${1:-}" == "--verbose" ]] && verbose=1
  dui_header "dots pull"
  if (( verbose )); then
    chezmoi update -v 2>&1 | sed 's/^/      /'
  else
    dui_spin "fetching + applying" chezmoi update
  fi
  dui_notify "dotfiles" "pulled from origin"
  dui_footer "in sync with origin"
}

_dots_push() {
  local repo="$HOME/.local/share/chezmoi"
  dui_header "dots push"
  dui_spin "re-adding local changes" chezmoi re-add
  if [ -z "$(git -C "$repo" status -s)" ]; then
    dui_info "nothing to commit"
    dui_footer "already in sync"
    return
  fi
  dui_section "Changes"
  git -C "$repo" status -s | sed 's/^/      /'
  local msg="${*:-chore(config): sync from local}"
  dui_spin "commit + push" sh -c "
    git -C '$repo' add -A &&
    git -C '$repo' commit -m '$msg' &&
    git -C '$repo' push
  "
  local short=$(git -C "$repo" rev-parse --short HEAD)
  dui_ok "pushed ${DUI[orange]}$short${DUI[r]} to origin/master"
  dui_notify "dotfiles" "pushed $short"
  dui_footer
}

# ── stats / backup / welcome ──────────────────────────────────────────────────
_dots_stats() {
  local repo="$HOME/.local/share/chezmoi"
  if command -v onefetch >/dev/null 2>&1; then
    onefetch "$repo" --no-color-palette --no-art 2>/dev/null
    return
  fi
  local managed=$(chezmoi managed 2>/dev/null | wc -l | tr -d ' ')
  local commits=$(git -C "$repo" rev-list --count HEAD 2>/dev/null)
  local last=$(git -C "$repo" log -1 --format='%cr' 2>/dev/null)
  local size=$(du -sh "$repo" 2>/dev/null | awk '{print $1}')
  dui_header "dots stats"
  dui_section "Repository"
  dui_info "$commits commits · last update ${DUI[green]}$last${DUI[r]}"
  dui_info "source size ${DUI[green]}$size${DUI[r]}"
  dui_section "Coverage"
  dui_info "${DUI[green]}$managed${DUI[r]} managed paths"
  dui_footer
}

_dots_backup() {
  local dest="${1:-$HOME/Backups}"
  local keep="${DOTS_BACKUP_KEEP:-10}"
  local stamp=$(date +%Y%m%d-%H%M%S)
  mkdir -p "$dest"
  local out="$dest/dotfiles-snapshot-$stamp.tar.zst"
  dui_header "dots backup" "$out"
  dui_spin "compressing config + dotfiles" \
    tar --use-compress-program=zstd -cf "$out" -C "$HOME" \
    .config .zshrc .gitconfig .gitignore_global .zsh 2>/dev/null
  local size=$(du -sh "$out" 2>/dev/null | awk '{print $1}')
  dui_info "snapshot size: ${DUI[green]}$size${DUI[r]}"
  # Retention: keep last N snapshots
  local pruned=$(ls -1t "$dest"/dotfiles-snapshot-*.tar.zst 2>/dev/null | tail -n +$((keep+1)) | wc -l | tr -d ' ')
  if (( pruned > 0 )); then
    ls -1t "$dest"/dotfiles-snapshot-*.tar.zst 2>/dev/null | tail -n +$((keep+1)) | xargs rm -f
    dui_info "pruned $pruned older snapshot(s) — keeping last $keep"
  fi
  dui_notify "dotfiles" "backup saved ($size)"
  dui_footer "stored at $out"
}

# ── Explore ───────────────────────────────────────────────────────────────────
_dots_diff() {
  dui_header "dots diff" "source ↔ home"
  if command -v delta >/dev/null 2>&1; then
    chezmoi diff "$@" | delta --paging=never
  else
    chezmoi diff "$@"
  fi
}

_dots_search() {
  command -v fzf >/dev/null 2>&1 || { dui_err "fzf required"; return 1; }
  local file=$(chezmoi managed | fzf --prompt="dots ❯ " \
    --preview="bat --color=always --style=numbers ${HOME}/{} 2>/dev/null || cat ${HOME}/{}" \
    --preview-window=right:60%:wrap)
  [ -z "$file" ] && return
  print -P "  ${DUI[dim]}${HOME}/${file}${DUI[r]}"
  echo "${HOME}/${file}"
}

_dots_edit() {
  local file=$(_dots_search)
  [ -z "$file" ] && return
  chezmoi edit "$file"
}

_dots_docs() {
  if command -v glow >/dev/null 2>&1; then
    glow -p "$HOME/.local/share/chezmoi/README.md"
  else
    bat "$HOME/.local/share/chezmoi/README.md"
  fi
}

# ── Productivity ──────────────────────────────────────────────────────────────
_dots_focus() {
  dui_header "dots focus" "DnD + distractions away"
  if [[ "$OSTYPE" == darwin* ]]; then
    osascript -e 'tell application "System Events" to keystroke "d" using {control down, option down}' 2>/dev/null || true
    dui_ok "toggled macOS Focus (DnD)"
  fi
  local quit_list=(Slack Discord Messages Mail "Microsoft Teams" Telegram WhatsApp)
  local killed=0
  for app in $quit_list; do
    if pgrep -xq "$app" 2>/dev/null; then
      osascript -e "tell application \"$app\" to quit" 2>/dev/null && ((killed++))
    fi
  done
  (( killed > 0 )) && dui_ok "quit $killed distracting app(s)" || dui_info "no distracting apps running"
  dui_notify "focus mode" "minimal mode engaged"
  dui_footer "deep work · ${DICO[spark]}"
}

_dots_audit() {
  dui_header "dots audit" "permissions + secrets check"
  dui_section "Sensitive paths"
  for path in ~/.ssh ~/.ssh/config ~/.gnupg ~/.zsh_secrets ~/.aws ~/.config/doppler; do
    [ ! -e "$path" ] && { dui_info "$path (not present)"; continue; }
    local perm=$(stat -f "%OLp" "$path" 2>/dev/null || stat -c "%a" "$path" 2>/dev/null)
    local kind="dir"; [ -f "$path" ] && kind="file"
    local expected="600"
    [ "$kind" = "dir" ] && expected="700"
    if [[ "$perm" == "$expected" || "$perm" == "400" ]]; then
      dui_ok "$path ${DUI[dim]}($perm)${DUI[r]}"
    else
      dui_warn "$path ${DUI[orange]}($perm — expected $expected)${DUI[r]}"
    fi
  done
  dui_section "Secret leaks"
  if command -v gitleaks >/dev/null 2>&1; then
    local repo="$HOME/.local/share/chezmoi"
    if gitleaks detect --source="$repo" --no-banner --redact --exit-code 0 >/dev/null 2>&1; then
      dui_ok "no secrets in dotfiles repo"
    else
      dui_err "gitleaks found suspicious patterns — run: gitleaks detect --source=$repo"
    fi
  else
    dui_warn "gitleaks not installed"
  fi
  dui_footer
}

_dots_bench() {
  dui_header "dots bench" "zsh startup profiling"
  if ! command -v hyperfine >/dev/null 2>&1; then
    dui_warn "hyperfine not installed — falling back to simple timing"
    for i in 1 2 3; do
      /usr/bin/time -p zsh -i -c exit 2>&1 | sed 's/^/      /'
    done
    return
  fi
  hyperfine --warmup 1 --runs 5 'zsh -i -c exit'
  dui_footer "tip: ZSH_PROFILING=1 exec zsh && zprof | head -30"
}

_dots_welcome() {
  dui_header "welcome back, {{ .name }}" "$(date '+%A %d %B %Y')"
  dui_section "Active features"
{{ range $k, $v := .features }}{{ if $v }}  print -P "    ${DUI[green]}${DICO[ok]}${DUI[r]} {{ $k }}"
{{ else }}  print -P "    ${DUI[dim]}${DICO[dot]} {{ $k }} (off)${DUI[r]}"
{{ end }}{{ end }}
  dui_section "Commands"
  print -P "    ${DUI[purple]}dots${DUI[r]}        show help"
  print -P "    ${DUI[purple]}dots status${DUI[r]} sync state"
  print -P "    ${DUI[purple]}dots doctor${DUI[r]} health check"
  dui_footer "happy hacking ${DICO[spark]}"
}

# ── short aliases (back-compat) ───────────────────────────────────────────────
alias dots-status='dots status'
alias dots-pull='dots pull'
alias dots-push='dots push'
alias dots-doctor='dots doctor'
alias dots-update='dots update'
alias dots-stats='dots stats'
alias dots-backup='dots backup'
alias d='dots'
