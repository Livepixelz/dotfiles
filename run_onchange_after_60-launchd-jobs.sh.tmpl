{{- if and (eq .chezmoi.os "darwin") .features.scheduled_jobs -}}
#!/usr/bin/env bash
# hash: {{ include "Library/LaunchAgents/com.livepixelz.dots-update.plist.tmpl" | sha256sum }}{{ include "Library/LaunchAgents/com.livepixelz.dots-backup.plist.tmpl" | sha256sum }}{{ include "Library/LaunchAgents/com.livepixelz.brewfile-dump.plist.tmpl" | sha256sum }}
set -euo pipefail
for label in com.livepixelz.dots-update com.livepixelz.dots-backup com.livepixelz.brewfile-dump; do
  launchctl bootout "gui/$UID/$label" 2>/dev/null || true
  launchctl bootstrap "gui/$UID" "$HOME/Library/LaunchAgents/$label.plist" 2>/dev/null && \
    echo "✓ scheduled $label"
done
{{- end -}}
